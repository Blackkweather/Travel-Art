# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# API URL (optional - defaults to /api)
VITE_API_URL=/api

# Payments run entirely server-side via Stripe Checkout Sessions - the
# backend creates a session and the client is redirected to its own URL, so
# no Stripe.js/publishable key is loaded or needed here.

# ArcGIS Location Platform key for the residencies map on /experiences.
# Publishable: it ships inside the bundle, so the referrer allowlist on the
# key is what limits it, not secrecy. Restrict it to your own domains.
# Unset is safe - the map falls back to CARTO's free tiles rather than
# rendering an empty grey box.
VITE_ARCGIS_API_KEY=

# Cloudflare Turnstile site key for the registration captcha. Must be set
# together with TURNSTILE_SECRET_KEY on the API; leave both unset to disable.
VITE_TURNSTILE_SITE_KEY=

# Public contact address shown in the footer, legal pages and support box.
# Set it once the site's own domain has a mailbox.
VITE_CONTACT_EMAIL=
