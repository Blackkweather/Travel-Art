// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Vercel Functions run on Amazon Linux; without this target the query engine
  // built for the local platform is the only one bundled and requests fail.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  role         String   @default("ARTIST") // ARTIST, HOTEL, ADMIN
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  country      String?
  language     String   @default("en")
  isActive     Boolean  @default(true)
  clerkId      String?  @unique // Clerk user ID for authentication

  // Relations
  artist       Artist?
  hotel        Hotel?
  notifications Notification[]
  referralsSent Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referee")
  payments      Payment[]
  adminLogs    AdminLog[]

  @@map("users")
}

model Artist {
  id                String   @id @default(cuid())
  userId            String   @unique
  stageName         String?  // Artist's stage/professional name
  birthDate         String?  // Artist's birth date (DD/MM/YYYY format)
  phone             String?  // Artist's phone number
  bio               String?
  discipline        String
  priceRange        String
  membershipStatus  String   @default("INACTIVE") // ACTIVE, INACTIVE, EXPIRED, PENDING
  membershipRenewal DateTime?
  images            String?  // JSON string of image URLs
  videos            String?  // JSON string of video URLs
  mediaUrls         String?  // JSON string of media URLs
  profilePicture    String?  // Main profile picture URL
  artisticProfile   String?  // JSON string: {mainCategory, secondaryCategory, audienceType, languages, categoryType, specificCategory, domain}
  referralCode      String   @unique @default(cuid())
  loyaltyPoints     Int      @default(0)

  /// What a hotel pays, in credits, to book this artist. Varies with the
  /// artist's standing outside the platform: a headline act might be 100,
  /// an emerging local musician 5.
  ///
  /// Deliberately NOT derived from the rank tier. Rank is reputation earned
  /// here (rating and completed bookings), so a famous artist joining today
  /// would compute as the lowest tier while still commanding the highest fee.
  /// Set by an admin at onboarding and adjustable afterwards.
  bookingCreditCost Int      @default(5)

  createdAt         DateTime @default(now())

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability      ArtistAvailability[]
  bookings          Booking[]
  ratings           Rating[]
  transactions      Transaction[]
  trips             Trip[]   // Experiences featuring this artist
  memberships       Membership[]
  payouts           Payout[]

  // membershipStatus above is now derived state: the Membership rows are
  // authoritative. It is kept for the existing queries that read it and
  // should be backfilled from Membership, then dropped.
  @@map("artists")
}

model Hotel {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  description     String?
  location        String   // JSON string: {city, country, coords}
  contactPhone    String?
  images          String?  // JSON string of image URLs
  profilePicture  String?  // Main profile picture URL
  performanceSpots String? // JSON string of performance spots
  rooms           String?  // JSON string of room data
  repName         String?
  responsiblePhone String? // Phone number for WhatsApp contact (responsible person)
  responsibleEmail String? // Email for direct contact (responsible person)
  responsibleName  String? // Name of the responsible person for contact
  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities  Availability[]
  bookings        Booking[]
  ratings         Rating[]
  credits         Credit[]
  creditLedger    CreditLedger[]
  transactions    Transaction[]
  trips           Trip[]   // Experiences at this hotel

  @@map("hotels")
}

model Availability {
  id        String   @id @default(cuid())
  hotelId   String
  roomId    String
  dateFrom  DateTime
  dateTo    DateTime
  price     Float?

  // Relations
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model ArtistAvailability {
  id        String   @id @default(cuid())
  artistId  String
  dateFrom  DateTime
  dateTo    DateTime

  // Relations
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("artist_availability")
}

model Booking {
  id                String   @id @default(cuid())
  hotelId           String
  artistId          String
  startDate         DateTime
  endDate           DateTime
  status            String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, COMPLETED, CANCELLED
  creditsUsed       Int      @default(0) // Deprecated - superseded by creditCost below

  /// Credits this booking cost, copied from the artist at the moment of
  /// booking. Stored rather than looked up so that repricing an artist later
  /// never rewrites the cost of bookings already made, and so the ledger,
  /// the booking and any invoice always agree.
  creditCost        Int      @default(0)
  weeklyPaymentAmount Float  @default(200.0) // Weekly payment amount in EUR
  numberOfWeeks      Int      // Number of weeks for this booking
  totalPaymentAmount Float   // Total payment (weeklyPaymentAmount * numberOfWeeks)
  paymentStatus      String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  notes              String?
  createdAt         DateTime @default(now())

  // Relations
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  artist            Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  ratings           Rating[]

  // Postgres does not index foreign keys automatically. Without these, every
  // dashboard listing and status count is a sequential scan over all bookings.
  @@index([hotelId])
  @@index([artistId])
  @@index([status])
  @@index([startDate])
  @@map("bookings")
}

model Rating {
  id                   String   @id @default(cuid())
  bookingId            String
  hotelId              String
  artistId             String
  stars                Int
  textReview           String
  createdAt            DateTime @default(now())
  isVisibleToArtist    Boolean  @default(false)

  // Relations
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel                Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  artist               Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  // hotels.ts fetches ratings per artist inside a Promise.all over a page of
  // artists, so this index is what stops that becoming an N+1 of table scans.
  @@index([artistId])
  @@index([bookingId])
  @@map("ratings")
}

/// Running balance, kept only as a cache for fast reads.
/// CreditLedger is the source of truth: a balance that disagrees with
/// SUM(credit_ledger.delta) for the same hotel is by definition wrong and
/// should be rebuilt from the ledger, never the other way round.
model Credit {
  id           String @id @default(cuid())
  hotelId      String @unique
  totalCredits Int    @default(0)
  usedCredits  Int    @default(0)

  // Relations
  hotel        Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("credits")
}

/// Append-only record of every credit movement. Never updated, never deleted.
/// Grants are positive, spends are negative, and the balance is the sum.
/// This is what makes a disputed invoice answerable.
model CreditLedger {
  id        String       @id @default(cuid())
  hotelId   String
  delta     Int
  reason    LedgerReason
  bookingId String?
  paymentId String?
  note      String?
  createdAt DateTime     @default(now())

  hotel     Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([createdAt])
  @@index([bookingId])
  @@map("credit_ledger")
}

/// The single source of truth for credit pack pricing. Prices must never be
/// duplicated in the frontend or hardcoded in a route: both were previously
/// true and disagreed by a factor of thirty.
model CreditPackage {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  credits      Int
  bonusCredits Int       @default(0)
  priceCents   Int
  currency     String    @default("EUR")
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments     Payment[]

  @@index([active])
  @@map("credit_packages")
}

/// Artist membership. Nothing previously wrote membershipStatus = ACTIVE, so
/// no artist could hold a membership and every referral stayed PENDING forever.
model Membership {
  id             String           @id @default(cuid())
  artistId       String
  tier           MembershipTier
  priceCents     Int
  currency       String           @default("EUR")
  status         MembershipStatus @default(PENDING)
  startsAt       DateTime?
  endsAt         DateTime?
  stripeSubId    String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  artist         Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([artistId])
  @@index([status])
  @@index([endsAt])
  @@map("memberships")
}

/// One row per Stripe charge. stripePaymentIntentId is unique so a retried
/// webhook can never be applied twice.
model Payment {
  id                    String         @id @default(cuid())
  stripePaymentIntentId String?        @unique
  stripeSessionId       String?        @unique
  actorUserId           String
  amountCents           Int
  currency              String         @default("EUR")
  status                PaymentStatus  @default(PENDING)
  packageId             String?
  membershipId          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  actor                 User           @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  creditPackage         CreditPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  membership            Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  ledgerEntries         CreditLedger[]

  @@index([actorUserId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

/// What the platform owes an artist for a completed booking. Nothing paid
/// artists before: a grep for "payout" across the backend returned nothing.
model Payout {
  id               String       @id @default(cuid())
  artistId         String
  bookingId        String       @unique
  amountCents      Int
  currency         String       @default("EUR")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @unique
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  artist           Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([status])
  @@map("payouts")
}

/// Stripe retries webhooks. Recording the event id makes replay a no-op
/// instead of a second grant of credits.
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       String?

  @@index([type])
  @@map("webhook_events")
}

enum LedgerReason {
  PURCHASE
  BOOKING_SPEND
  BOOKING_REFUND
  ADMIN_ADJUSTMENT
  PROMOTIONAL_GRANT
}

enum MembershipTier {
  ARTIST
  PROFESSIONAL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Transaction {
  id        String   @id @default(cuid())
  hotelId   String?
  artistId  String?
  type      String   // CREDIT_PURCHASE, MEMBERSHIP, BOOKING_FEE, REFUND, WEEKLY_PAYMENT
  amount    Float
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  createdAt DateTime @default(now())

  // Relations
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)

  // Financial history is queried per hotel and per period on every dashboard
  // and export, so these cannot be left unindexed.
  @@index([hotelId])
  @@index([artistId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

model Referral {
  id             String   @id @default(cuid())
  inviterUserId   String
  inviteeUserId   String
  rewardPoints    Int      @default(100)
  createdAt       DateTime @default(now())

  // Relations
  inviter         User     @relation("Referrer", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee         User     @relation("Referee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([inviterUserId, inviteeUserId])
  @@map("referrals")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // BOOKING_CONFIRMED, BOOKING_CANCELLED, RATING_RECEIVED, MEMBERSHIP_EXPIRING, REFERRAL_REWARD, ADMIN_NOTIFICATION
  payload   String   // JSON string
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AdminLog {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String
  targetId     String?
  createdAt    DateTime @default(now())

  // Relations
  actor        User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

// Travel Art MVP - Trip model (public experiences)
model Trip {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  priceFrom   Decimal
  priceTo     Decimal
  location    String   // JSON string: {city, country, lat, lng}
  images      String   // JSON string array of image URLs
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  
  // Additional experience details
  artistId    String?  // Optional link to Artist
  hotelId     String?  // Optional link to Hotel
  type        String?  // rooftop, intimate, workshop, residency
  rating      Float?   @default(4.5)
  date        DateTime? // Experience date
  duration    String?  // e.g., "2 hours", "7 days"
  capacity    String?  // e.g., "50 guests", "25 participants"
  schedule    String?  // JSON string array: [{time, activity}]
  includes    String?  // JSON string array of included items
  artistBio   String?  // Artist biography for this experience
  venueDetails String? // Venue/hotel details for this experience
  reviews     String?  // JSON string array: [{author, rating, comment}]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@map("trips")
}

// Note: Using String fields for some legacy enums for compatibility
// Valid values are documented in the model field comments above
