# ============================================
# TRAVEL ART BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# SUPABASE DATABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database

# Your Supabase Project Reference ID
SUPABASE_PROJECT_REF=your_project_ref_here

# Your Database Password (URL-encode special characters: ; = %3B, @ = %40, etc.)
SUPABASE_DB_PASSWORD=your_password_here

# Your Supabase Region (check Dashboard > Settings > General)
# Options: eu-west-1, eu-central-1, us-east-1, us-west-1, ap-southeast-1, ap-northeast-1
SUPABASE_REGION=eu-west-1

# Database Connection String (Transaction Pooler - Port 6543 RECOMMENDED)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL for migrations (Session Pooler - Port 5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# ============================================
# SUPABASE API KEYS
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================
# PAYMENT CONFIGURATION (Optional)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transactional email (Resend) ------------------------------------------
# Optional. Without RESEND_API_KEY the app still runs: sends are skipped and
# logged, registration and password reset still succeed, and in development the
# confirmation/reset links are printed to the server console instead.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Resend's sandbox sender works with no domain verification. Override once you
# have verified your own domain, e.g. "Travel Art <bonjour@travelart.fr>".
RESEND_FROM=
# Optional. Where a "new registration" alert is sent when an artist or hotel
# applies. Unset means no one is notified - the registration itself still
# succeeds either way.
ADMIN_NOTIFY_EMAIL=

# --- Runtime database connection (row-level security) -----------------------
# The API connects as a restricted role that CANNOT bypass row-level security,
# so the policies on bookings/credits/transactions/payments actually apply.
# DATABASE_URL stays pointed at the owner and is used for migrations and the
# seed. Leaving APP_DATABASE_URL unset makes the API use the owner connection,
# which disables RLS enforcement - that is the intended rollback switch.
# Create the role with: APP_DB_PASSWORD='...' npx tsx prisma/rls/apply.ts
APP_DATABASE_URL=

# --- Registration protection --------------------------------------------------
# Cloudflare Turnstile secret. When set, registration requires a valid captcha
# token; set VITE_TURNSTILE_SITE_KEY in the frontend to the matching site key.
# Unset: no captcha (development, tests) - rate limits, e-mail and duplicate
# checks and admin review still apply.
TURNSTILE_SECRET_KEY=
# Required with the secret: the site hostnames a token may come from, comma
# separated. Empty = every token refused (fail closed). localhost is ignored
# in production.
TURNSTILE_HOSTNAMES=
# 0 skips the MX lookup on new e-mail domains (only the test suite needs this).
VERIFY_EMAIL_DOMAINS=1
# Optional overrides of the database-backed rate limits.
# AUTH_FAILURE_LIMIT=10      failed logins / resets per 15 min, per IP and per account
# REGISTER_LIMIT=5           registrations per hour per IP
# MAIL_LIMIT=5               verification / reset / invite e-mails per hour per IP
# AVAILABILITY_LIMIT=60      live availability checks per 15 min per IP

# --- The convention ---------------------------------------------------------
# The third party ("le Coordinateur") printed on every convention. Blank lines
# print as dotted lines to fill by hand.
COORDINATOR_NAME=Travel Art
COORDINATOR_ADDRESS=
COORDINATOR_REGISTRATION=
COORDINATOR_REPRESENTATIVE=
# "Fait à" on the convention; defaults to the hotel's city.
CONVENTION_PLACE=

# --- Videos -----------------------------------------------------------------
# 0 skips the YouTube/Vimeo lookups that check a video exists and whose
# channel it is (only the offline test suite needs this).
CHECK_VIDEO_LINKS=1

# --- Local tooling -----------------------------------------------------------
# 1 ignores the .env files and runs on the process environment alone, so a
# throwaway test server cannot pick up real mail, payment or database keys.
# SKIP_DOTENV=1
